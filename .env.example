APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dingconnect
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================================================
# DINGCONNECT API
# ==========================================================================
DING_API_URL=https://api.dingconnect.com
DING_API_KEY=
DING_API_SECRET=
DING_CUSTOMER_ID=
DING_WEBHOOK_SECRET=
DING_CALLBACK_URL=
DING_SANDBOX=true
DING_DEFAULT_AGENT=

# ==========================================================================
# STRIPE PAYMENT
# ==========================================================================
PAYMENT_GATEWAY=stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==========================================================================
# SMS GATEWAY
# ==========================================================================
SMS_GATEWAY=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MKNETW
MSG91_TEMPLATE_ID=

# ==========================================================================
# PLATFORM SETTINGS
# ==========================================================================
PLATFORM_MIN_RECHARGE=1
PLATFORM_MAX_RECHARGE=10000
PLATFORM_MARKUP=0
PLATFORM_CURRENCY=GBP
PLATFORM_WALLET_LOAD_FEE_PERCENTAGE=0
PLATFORM_WALLET_LOAD_FEE_FLAT=0

# ==========================================================================
# PUSHER (Real-time Notifications)
# ==========================================================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1
