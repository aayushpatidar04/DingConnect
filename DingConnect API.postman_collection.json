{
  "info": {
    "_postman_id": "e331be21-4ef8-49f9-bdf6-23574dacda41",
    "name": "DingConnect API",
    "description": "DingConnect mobile application API. Set base_url to the application origin and token to a Sanctum bearer token. See API_DOCUMENTATION.md for request details, validation, and response behavior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "country_iso",
      "value": "GB",
      "type": "string"
    },
    {
      "key": "retailer_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "operator_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "transaction_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "allowed_number_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "allowed_file_id",
      "value": "1",
      "type": "string"
    }
